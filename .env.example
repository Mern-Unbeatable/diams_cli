# Backend API base URL (no trailing slash required — axios joins paths)
VITE_API_BASE_URL=http://localhost:3000/api

# Feature APIs return demo mocks unless set to false
VITE_USE_API_MOCKS=true

# Crisp chat website ID (Crisp dashboard → Settings → Website Settings → Setup)
# Leave empty to disable the chat widget
VITE_CRISP_WEBSITE_ID=
